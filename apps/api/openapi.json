        "required": ["user_id", "role", "tenant"],
        "title": "MeOut",
        "type": "object"
      },
      "PlanogramIn": {
        "description": "Replace a shelf's planogram wholesale.",
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/components/schemas/PlanogramSlotIn"
