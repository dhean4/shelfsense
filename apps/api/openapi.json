          "status": {
            "enum": ["ok", "fail"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "CheckResult",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body of every 4xx/5xx the API raises deliberately.",
