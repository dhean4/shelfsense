{
  "name": "shelfsense",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic retail and cold-chain field-ops platform: shelf photos + IoT telemetry in, reviewed decisions out.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
