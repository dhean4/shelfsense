    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8"
  }
}
